# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trainforge

# OpenAI (for AI exercise generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Resend (for email sending)
RESEND_API_KEY=re_your-resend-api-key-here
EMAIL_FROM_ADDRESS=noreply@trainforge.app
EMAIL_FROM_NAME=TrainForge

# Render production (set in Render dashboard, not in .env)
# DATABASE_URL=postgres://user:pass@host:port/dbname
# ALLOWED_HOSTS=trainforge.onrender.com
